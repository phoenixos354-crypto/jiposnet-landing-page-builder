# ============================================================
# JIPOSNET Frontend (TanStack Start di Vercel) — contoh environment
# ============================================================
# Salin jadi ".env" untuk development lokal (npm run dev), lalu isi
# nilai sebenarnya. Untuk production, isi nilai yang sama di
# Vercel Dashboard > Project Settings > Environment Variables.

# --- Server-only (JANGAN pernah diberi prefix VITE_) ---
# URL root PHP API di shared hosting (tanpa trailing slash).
API_BASE_URL=https://domainhosting-anda.com/api

# Harus SAMA PERSIS dengan API_SECRET_KEY di /api/.env (backend PHP).
API_SECRET_KEY=ganti_dengan_string_acak_sama_dengan_backend

# --- Opsional: purge cache Vercel CDN otomatis setelah admin simpan ---
# Kalau salah satu kosong, purge otomatis dilewati (tidak bikin request gagal) —
# perubahan tetap muncul dalam waktu singkat lewat stale-while-revalidate.
# Buat token di: https://vercel.com/account/tokens
VERCEL_API_TOKEN=
# Project ID/slug Vercel (Project Settings > General)
VERCEL_PROJECT_ID=
# Hanya perlu diisi kalau project berada di bawah akun Team
VERCEL_TEAM_ID=ff

# --- Public (WAJIB pakai prefix VITE_ — nilai ini ikut ke bundle browser) ---
# Domain tempat file yang diupload admin bisa diakses publik.
# Biasanya SAMA dengan domain di API_BASE_URL tapi TANPA path "/api".
# Contoh: API_BASE_URL=https://domainhosting-anda.com/api
#      -> VITE_ASSETS_BASE_URL=https://domainhosting-anda.com
VITE_ASSETS_BASE_URL=https://domainhosting-anda.com
